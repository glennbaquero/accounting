			        children: [ {
			            id: 'ig_1',
			            label: '1',
			            isDisabled: false
			        }, {
			            id: 'ig_2',
			            label: '2',
			            isDisabled: false
					} ],
				   	}],



			}
		},

		methods: {
			datePickerClosed(item) {
				item.date = moment(item.date).format('MM/DD/YYYY');
				this.showOnlyData.date = true;
			},

			selectedLine(item) {
				_.each(this.items, (item) => {
					item.selected = false;	
				})
				item.selected = true;
				this.selected = item;
			},

			dataSelected(item) {
				item.alreadyInSelectedItem = !item.alreadyInSelectedItem;
			},
		}

	}
</script>