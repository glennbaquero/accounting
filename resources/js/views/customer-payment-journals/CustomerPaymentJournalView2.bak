<script>

	import Selectize from 'vue2-selectize';
	import selectizecss from 'selectize/dist/css/selectize.css';

	import Datepicker from 'vuejs-datepicker';
    import DataTable from 'Components/tables/DataTable.vue';

	import Card from 'Components/containers/Card.vue';
	import FormRequest from 'Components/forms/FormRequest.vue';

	export default {
		props: {
			submitUrl: String
		},

        computed: {
            headers() {
                let array = [
                    { text: '', value: '' },
                    { text: 'Date', value: null },
                    { text: 'Company accounts', value: null },
                    { text: 'Account', value: null },
                    { text: 'Description', value: null },
                    { text: 'Debit', value: null },
                    { text: 'Credit', value: null },
                    { text: 'Offset account type', value: null },
                    { text: 'Offset account', value: null },
                ];

                return array;
            },

            balanceJournal() {
            	var credit = 0;
            	var debit = 0;

            	credit = _.sumBy(this.items, (item) => {
            		return parseFloat(item.credit);
            	});

            	debit = _.sumBy(this.items, (item) => {
            		return parseFloat(item.debit);
            	});

            	return parseFloat(credit - debit);
            },

            balancePerVoucher() {
            	var credit = 0;
            	var debit = 0;

            	credit = _.sumBy(this.items, (item) => {
            		if(item.alreadyInSelectedItem) {
	            		return parseFloat(item.credit);
            		} else {
            			return 0;
            		}
            	});

            	debit = _.sumBy(this.items, (item) => {
            		if(item.alreadyInSelectedItem) {
	            		return parseFloat(item.debit);
            		} else {
            			return 0;
            		}
            	});

            	return parseFloat(credit - debit);
            },

            debitJournal() {
            	return _.sumBy(this.items, (item) => {
            		return parseFloat(item.debit);
            	});
            },

            debitPerVoucher() {
            	return _.sumBy(this.items, (item) => {
            		if(item.alreadyInSelectedItem) {
	            		return parseFloat(item.debit);
            		} else {
            			return 0;
            		}
            	});
            },


            creditJournal() {
            	return _.sumBy(this.items, (item) => {
            		return parseFloat(item.credit);
            	});
            },

            creditPerVoucher() {
            	return _.sumBy(this.items, (item) => {
            		if(item.alreadyInSelectedItem) {
	            		return parseFloat(item.credit);
            		} else {
            			return 0;
            		}
            	});
            },
        },

		data() {
			return {
                items: [
                    {
                        id: 1,
                        date: '11/11/2020',
                        company_account: 'chap',
                        account: 'chap-000000',
                        invoice: '10001',
                        description: null,
                        debit: 0,
                        credit: 1275.00,
                        offset_account_type: 'Bank',
                        offset_account: '7000-001-201-101',

                        selected: false,
                        alreadyInSelectedItem: false,

						voucher: 'chap-APP',
						currency: 'USD',
						account_name: 'Corbin Supply',
						offset_account_name: 'Operating Bank Account',
						method_of_payments: 'CHECK',
						payment_specification: null,
						payment_id: null,
						settlement_type: 'Designated Transaction',
						check_number: null,
						document: null,
						document_date: '10/11/2020',
						withholding_tax_group: null                       
                    },
                    {
                        id: 2,
                        date: '10/21/2020',
                        company_account: 'chap',
                        account: 'chap-000000',
                        invoice: '10001',
                        description: null,
                        debit: 0,
                        credit: 1500.00,
                        offset_account_type: 'Bank',
                        offset_account: '7000-001-201-101',

                        selected: false,
                        alreadyInSelectedItem: false,

						voucher: 'chap-APP',
						currency: 'USD',
						account_name: 'Corbin Supply',
						offset_account_name: 'Operating Bank Account',
						method_of_payments: 'CHECK',
						payment_specification: null,
						payment_id: null,
						settlement_type: 'Designated Transaction',
						check_number: null,
						document: null,
						document_date: '10/11/2020',
						withholding_tax_group: null                       
                    },
                    {
                        id: 2,
                        date: '09/21/2020',
                        company_account: 'chap',
                        account: 'chap-000000',
                        invoice: '10001',
                        description: null,
                        debit: 1500.00,
                        credit: 0,
                        offset_account_type: 'Bank',
                        offset_account: '7000-001-201-101',

                        selected: false,
                        alreadyInSelectedItem: false,

						voucher: 'chap-APP',
						currency: 'USD',
						account_name: 'Corbin Supply',
						offset_account_name: 'Operating Bank Account',
						method_of_payments: 'CHECK',
						payment_specification: null,
						payment_id: null,
						settlement_type: 'Designated Transaction',
						check_number: null,
						document: null,
						document_date: '10/11/2020',
						withholding_tax_group: null                       
                    },
                ],

                showOnlyData: {
                	date: true,
                	account_type: true,
                	credit: true,
                	debit: true,
                	description: true,
                	offset_account: true,
                	offset_account_type: true
                },

                selected: {
            		voucher: null,
					currency: null,
					account_name: null,
					offset_account_name: null,
					method_of_payments: null,
					payment_specification: null,
					payment_id: null,
					settlement_type: null,
					check_number: null,
					document: null,
					document_date: null,
					withholding_tax_group: null  
                },
	      	}
		},

		components: {
			'card': Card,
            'data-table': DataTable,
		    'selectize': Selectize,
		    'datepicker': Datepicker,
			'form-request': FormRequest,
		},

		watch: {
			items(val) {
				this.init();
			}
		},

		mounted() {
			this.init();
		},

		methods: {
			init() {
				//
			},

			getTotalCredit() {

			},

			onEnter(e, input) {
				if(e.keyCode === 13) {
					this.showOnlyData[input] = true; 
				}
			},

			selectedLine(item) {
				_.each(this.items, (item) => {
					item.selected = false;	
				})
				item.selected = true;
				this.selected = item;
			},

			dataSelected(item) {
				item.alreadyInSelectedItem = !item.alreadyInSelectedItem;
			},

			datePickerClosed(item) {
				item.date = moment(item.date).format('MM/DD/YYYY');
				this.showOnlyData.date = true;
			}

		}
	}
</script>

