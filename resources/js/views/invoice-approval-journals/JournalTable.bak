<script>
	import { bus }from 'Root/bus.js';

	export default {
		props: {
			type: String,

		},

		data() {
			return {
				items: [],
                selected: {},
                item: {},

                cost_centers: [],
                departments: [],
                expense_purposes: [],
			}
		},

		computed: {
			headers() {
				let array = [];

                switch(this.type) {
                    case 'overview': 
                        array = [
                            { text: '', value: '' },
                            { text: 'Name', value: 'name' },
                            { text: 'Journal batch number', value: 'journal_batch_number' },
                            { text: 'Journal name', value: 'journal_name' },
