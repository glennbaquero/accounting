<template>
	<div>
		<form-request :submit-url="submitUrl" @load="load" @success="fetch" confirm-dialog sync-on-success>
			<card>
				<template v-slot:header>
					Sales Order Information
					<div class="float-right">
						<action-button type="submit" :disabled="loading" class="btn-primary">Save Changes</action-button>
						<button type="button" class="btn btn-success" @click="confirmedSO" :disabled="disableConfirmButton">Confirm SO</button>
						<a :href="item.vendorInvoiceUrl" class="btn btn-success" :class="disableGenerateInvoiceButton ? 'disabled' : ''">Generate Invoice</a>
					</div>
				</template>
				<div class="card">
				    <div class="card-header p-2">
				        <ul class="nav nav-pills">
				            <!-- <li class="nav-item"><a class="nav-link " href="#general" data-toggle="tab">General</a></li> -->
				            <li class="nav-item"><a class="nav-link active" href="#sales_order" data-toggle="tab">Sales Order</a></li>
				            <!-- <li class="nav-item"><a class="nav-link" href="#customer" data-toggle="tab">Customer Information</a></li> -->
				            <li class="nav-item"><a class="nav-link" href="#financial" data-toggle="tab">Financial dimensions</a></li>
				            <li class="nav-item"><a class="nav-link" href="#delivery" data-toggle="tab">Delivery</a></li>
				            <li class="nav-item"><a class="nav-link" href="#price_discount" data-toggle="tab">Totals</a></li>
				            <li class="nav-item"><a class="nav-link" href="#sales_order_lines" data-toggle="tab">Sales order lines</a></li>
				        </ul>
				    </div>

				    <div class="card-body">
				        <div class="tab-content">
				        	<div class="tab-pane " id="general">
		        				<div class="row">
		        		    		<div class="form-group col-sm-6">
		        		    			<label>Customer Account</label>
		        		                <select name="customer_account" v-model="item.customer_account" class="form-control">
		        		                	<option v-for="customer in customers" :value="customer.customer_account">{{ customer.customer_account }}</option>
		        		                </select>
		        		    		</div>
		        		    		<div class="form-group col-sm-6">
		        		    			<label>Invoice Account</label>
		        		                <select name="invoice_account" v-model="item.invoice_account" class="form-control">
		        		                	<option v-for="customer in customers" :value="customer.customer_account">{{ customer.customer_account }}</option>
		        		                </select>
		        		    		</div>
		        				</div>
				        	</div>

				        	<div class="tab-pane show active" id="sales_order">
		        				<div class="row">
		        					<div class="col-md-6">
		        						<div class="form-group">
		        							<label>Sales order</label><br>
		        							<p>Sales order number</p>
		        							<input type="text" name="sales_order_number" v-model="item.sales_order_number" class="form-control">
		        						</div>
		        						<div class="form-group">
		        							<label>Customer Account</label><br>
			        		    			<p>Customer Account</p>
			        		                <select name="customer_account" v-model="item.customer_account" class="form-control">
			        		                	<option v-for="customer in customers" :value="customer.customer_account">{{ customer.customer_account }}</option>
			        		                </select>
			        		    			<p>Invoice Account</p>
			        		                <select name="invoice_account" v-model="item.invoice_account" class="form-control">
			        		                	<option v-for="customer in customers" :value="customer.customer_account">{{ customer.customer_account }}</option>
			        		                </select>
			        		    		</div>	
		        						<div class="form-group">
			        		    			<p>Sales order date</p>
			        		    			<input ref="sales_order_date" type="text" class="form-control" name="sales_order_date" v-model="item.sales_order_date" readonly>
			        		    			<p>Delivery date</p>
			        		    			<input ref="delivery_date_pickr" type="text" class="form-control" name="delivery_date" v-model="item.delivery_date" readonly>
			        		    			<p>Due date</p>
			        		    			<input ref="due_date" type="text" class="form-control" name="due_date" v-model="item.due_date" readonly>
			        		    			<p>Confirmed date</p>
			        		    			<input ref="confirmed_date" type="text" class="form-control" name="confirmed_date" v-model="item.confirmed_date" readonly>
			        		    			<p>Accounting date</p>
			        		    			<input ref="accounting_date" type="text" class="form-control" name="accounting_date" v-model="item.accounting_date" readonly>
			        		    		</div>
		        					</div>

		        					<div class="col-md-6">
		        						<div class="form-group">
			        		    			<label>Customer Details</label><br>
							    			<p>Customer Name</p>
							                <input name="customer_name" v-model="item.customer_name" type="text" class="form-control">
							    			<p>Customer Address</p>
							                <textarea name="customer_address" v-model="item.customer_address" class="form-control">{{ item.customer_name }}</textarea>
							    			<p>Customer Contact ID</p>
							                <input name="customer_contact_id" v-model="item.customer_contact_id" type="text" class="form-control">
							    			<p>Sold By</p>
							    			<select name="sold_by" v-model="item.sold_by" class="form-control">
							    				<option v-for="user in users" :value="user.id">{{ user.fullname }}</option>
							    			</select>
		        						</div>
		        						<div class="form-group">
			        		    			<label>Status</label><br>
			        		    			<p>Sales order status</p>
			        		                <select name="sales_order_status" v-model="item.sales_order_status" class="form-control">
			        		                	<option value="Open Order" selected>Open Order</option>
			        		                	<option value="Delivered">Delivered</option>
			        		                	<option value="Invoiced">Invoiced</option>
			        		                	<option value="Canceled">Canceled</option>
			        		                </select>
			        		    			<p>Document status</p>
			        		                <select name="document_status" v-model="item.document_status" class="form-control">
			        		                	<option value="None" selected>None</option>
			        		                	<option value="Invoice">Invoice</option>
			        		                	<option value="Product Receipt">Product Receipt</option>
			        		                </select>
			        		    			<p>Approval status</p>
			        		                <select name="approval_status" v-model="item.approval_status" class="form-control">
			        		                	<option value="Draft" selected>Draft</option>
			        		                	<option value="Confirmed">Confirmed</option>
			        		                	<option value="Finalized">Finalized</option>
			        		                </select>
			        		    		</div>
			        		    		<div class="form-group">
							    			<label>Payments</label>
							    			<p>Payment methods</p>
							                <select name="method_of_payment" v-model="item.method_of_payment" class="form-control">
							    				<option v-for="method in payment_methods" :value="method.id">{{ method.name }}</option>
							                </select>
							    			<p>Terms of payment</p>
							                <select name="terms_of_payment" v-model="item.terms_of_payment" class="form-control">
							    				<option v-for="payment in terms_of_payments" :value="payment.terms_of_payment">{{ payment.terms_of_payment }}</option>
							                </select>
							    			<p>Payment specification</p>
							                <textarea name="payment_specification" v-model="item.payment_specification" class="form-control">{{ item.payment_specification }}</textarea>
							    			<p>Sales tax group</p>
							                <input name="sales_tax_group" v-model="item.sales_tax_group" type="text" class="form-control">
							    			<p>Tax exempt number</p>
							                <input name="tax_exempt_number" v-model="item.tax_exempt_number" type="text" class="form-control">
										</div>
		        					</div>
		        					
