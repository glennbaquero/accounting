				        	<div class="tab-pane" id="price_discount">
		        				<div class="row">
		        					<div class="col-md-6">
		        						<div class="form-group">
		        							<label>Data</label>
		        							<p>Total Quantity</p>
		        							<input name="total_data_quantity" :value="totalQuantity" type="text"  readonly class="form-control">
		        						</div>
		        						<div class="form-group">
			        		                <label>Totals</label><br>
											<!-- <p>Total Line Discount</p>
